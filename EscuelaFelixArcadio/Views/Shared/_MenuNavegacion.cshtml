<!-- Navigation Menu -->
<div class="sidebar-nav">
    @* Sección PLATAFORMA - Solo para Administrador y Docente *@
    @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
    {
        <div class="nav-section">
            <div class="nav-section-title">PLATAFORMA</div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Inventario")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Inventario" ? "active" : "")">
                        <i class="fas fa-boxes"></i>
                        <span>Inventario</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Categoria")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Categoria" ? "active" : "")">
                        <i class="fas fa-tags"></i>
                        <span>Categorías</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Prestamos")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Prestamos" ? "active" : "")">
                        <i class="fas fa-hand-holding"></i>
                        <span>Préstamos</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Sanciones")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Sanciones" ? "active" : "")">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Sanciones</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Productos")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Productos" ? "active" : "")">
                        <i class="fas fa-box"></i>
                        <span>Productos</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Separator -->
        <div class="nav-separator"></div>
    }

    @* Sección ADMINISTRACIÓN *@
    <div class="nav-section">
        <div class="nav-section-title">ADMINISTRACIÓN</div>
        <ul class="nav-menu">
            @* Administrativo - Solo para Administrador *@
            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Administrativo")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Administrativo" ? "active" : "")">
                        <i class="fas fa-users-cog"></i>
                        <span>Administrativo</span>
                    </a>
                </li>
            }

            @* Reportes - Para Administrador y Docente *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Reportes")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Reportes" ? "active" : "")">
                        <i class="fas fa-chart-line"></i>
                        <span>Reportes</span>
                    </a>
                </li>
            }

            @* Estadísticas - Para Administrador y Docente *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Estadisticas")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Estadisticas" ? "active" : "")">
                        <i class="fas fa-chart-bar"></i>
                        <span>Estadísticas</span>
                    </a>
                </li>
            }

            @* Deportivo - Para todos los roles autenticados *@
            <li class="nav-item">
                <a href="@Url.Action("Index", "Documento")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Documento" ? "active" : "")">
                    <i class="fas fa-running"></i>
                    <span>Deportivo</span>
                </a>
            </li>

            @* Espacios - Para todos los roles autenticados *@
            <li class="nav-item">
                <a href="@Url.Action("Index", "Espacios")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Espacios" ? "active" : "")">
                    <i class="fas fa-building"></i>
                    <span>Espacios</span>
                </a>
            </li>
        </ul>
    </div>
</div>
