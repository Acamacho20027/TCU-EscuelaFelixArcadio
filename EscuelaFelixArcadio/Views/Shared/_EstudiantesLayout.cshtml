<link href="~/Content/menu-navegacion.css?v=@DateTime.Now.Ticks" rel="stylesheet" />

<!-- Navigation Menu -->
<div class="sidebar-nav">
    @* Sección PLATAFORMA - Solo para Administrador y Docente *@
    @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
    {
        <div class="nav-section">
            <div class="nav-section-title">PLATAFORMA</div>
            <ul class="nav-menu">
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Inventario")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Inventario" ? "active" : "")">
                        <i class="fas fa-boxes"></i>
                        <span>Inventario</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Categoria")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Categoria" ? "active" : "")">
                        <i class="fas fa-tags"></i>
                        <span>Categorías</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Prestamos")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Prestamos" ? "active" : "")">
                        <i class="fas fa-hand-holding"></i>
                        <span>Préstamos</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Sanciones")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Sanciones" ? "active" : "")">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Sanciones</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Productos")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Productos" ? "active" : "")">
                        <i class="fas fa-box"></i>
                        <span>Productos</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Separator -->
        <div class="nav-separator"></div>
    }

    @* Sección ADMINISTRACIÓN *@
    <div class="nav-section">
        <div class="nav-section-title">ADMINISTRACIÓN</div>
        <ul class="nav-menu">
            @* Administrativo - Solo para Administrador *@
            @if (User.IsInRole("Administrador"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Administrativo")" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Administrativo" ? "active" : "")">
                        <i class="fas fa-users-cog"></i>
                        <span>Administrativo</span>
                    </a>
                </li>
            }

            @* Reportes - Para Administrador y Docente *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Reportes")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Reportes" ? "active" : "")">
                        <i class="fas fa-chart-line"></i>
                        <span>Reportes</span>
                    </a>
                </li>
            }

            @* Estadísticas - Para Administrador y Docente *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Docente"))
            {
                <li class="nav-item">
                    <a href="@Url.Action("Index", "Estadisticas")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Estadisticas" ? "active" : "")">
                        <i class="fas fa-chart-bar"></i>
                        <span>Estadísticas</span>
                    </a>
                </li>
            }

            @* Deportivo - Para todos los roles autenticados *@
            <li class="nav-item">
                <a href="@Url.Action("Index", "Documento")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Documento" ? "active" : "")">
                    <i class="fas fa-running"></i>
                    <span>Deportivo</span>
                </a>
            </li>

            @* Espacios - Para todos los roles autenticados *@
            <li class="nav-item" id="menu-espacios">
                <a href="@Url.Action("Index", "Espacios")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Espacios" ? "active" : "")">
                    <i class="fas fa-building"></i>
                    <span id="texto-espacios">Espacios</span>
                </a>
            </li>
        </ul>
    </div>
</div>

<script>
    // Script agresivo para forzar "Espacios" en el menú
    (function() {
        function forzarTextoEspacios() {
            // Método 1: Por ID
            var spanEspacios = document.getElementById('texto-espacios');
            if (spanEspacios) {
                spanEspacios.textContent = 'Espacios';
                spanEspacios.innerHTML = 'Espacios';
            }
            
            // Método 2: Por href que contenga "Espacios"
            var linksEspacios = document.querySelectorAll('a[href*="/Espacios"]');
            linksEspacios.forEach(function(link) {
                var span = link.querySelector('span');
                if (span) {
                    span.textContent = 'Espacios';
                    span.innerHTML = 'Espacios';
                }
            });
            
            // Método 3: Buscar por ícono de edificio y forzar texto
            var iconosEdificio = document.querySelectorAll('.fa-building');
            iconosEdificio.forEach(function(icono) {
                var link = icono.closest('.nav-link');
                if (link) {
                    var span = link.querySelector('span');
                    if (span) {
                        span.textContent = 'Espacios';
                        span.innerHTML = 'Espacios';
                    }
                }
            });
            
            // Método 4: Buscar cualquier span que diga "Reportes" y tenga ícono de edificio
            var todosLosSpans = document.querySelectorAll('.nav-link span');
            todosLosSpans.forEach(function(span) {
                var link = span.closest('.nav-link');
                if (link && link.querySelector('.fa-building')) {
                    span.textContent = 'Espacios';
                    span.innerHTML = 'Espacios';
                }
            });
        }
        
        // Ejecutar inmediatamente
        forzarTextoEspacios();
        
        // Ejecutar múltiples veces
        setTimeout(forzarTextoEspacios, 100);
        setTimeout(forzarTextoEspacios, 500);
        setTimeout(forzarTextoEspacios, 1000);
        setTimeout(forzarTextoEspacios, 2000);
        
        // Ejecutar cuando el DOM esté listo
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', forzarTextoEspacios);
        }
        
        // Ejecutar periódicamente
        setInterval(forzarTextoEspacios, 2000);
    })();
</script>
